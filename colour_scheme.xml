<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for MILA, sampled from images/mila_avatar.jpg.
  Avatar palette: cyan cyborg on deep navy.
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#070712"/>  <!-- window / page background -->
  <colour name="panel"            value="#0D0D21"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#191943"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#121230"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#E9F1F2"/>  <!-- primary text -->
  <colour name="text_sec"         value="#94A7A8"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#576A6B"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#1FD4DE"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#53DFE7"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#2183A8"/>  <!-- second avatar colour: highlights, tags -->
  <colour name="accent3"          value="#3C7BC0"/>  <!-- third avatar colour -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#0E2425"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
